    progress=excluded.progress,
    last_activity=CURRENT_TIMESTAMP
  `).run(institutionId,studentId,topicId,status,pct);

  res.json({success:true,progress:pct});
 }catch(e){
  res.status(400).json({success:false,error:e.message});
 }
