app.get('/api/v5/readiness/:studentId/:employerId', (req,res) => {



  const studentId=Number(req.params.studentId);



  const employerId=Number(req.params.employerId);







  if (!v3Exists('students',studentId))



    return res.status(404).json({



      ok:false,



      error:'Student not found'



    });







  if (!v3Exists('employers',employerId))



    return res.status(404).json({



      ok:false,



      error:'Employer not found'



    });







  const requirements=db.prepare(`



    SELECT



      er.skill_id,



      sk.name AS skill,



      er.required_level,



      er.importance,



      COALESCE(ss.level,0) AS student_level,



      COALESCE(ss.evidence_count,0) AS evidence_count



    FROM employer_requirements er



    JOIN skills sk ON sk.id=er.skill_id



    LEFT JOIN student_skills ss



      ON ss.skill_id=er.skill_id



      AND ss.student_id=?



    WHERE er.employer_id=?



  `).all(studentId,employerId);







  let totalWeight=0;



  let weightedScore=0;



  let gaps=0;







  const skills=requirements.map(r=>{



    const required=Math.max(1,Number(r.required_level));



    const current=Number(r.student_level);



    const importance=Math.max(0.1,Number(r.importance));







    const match=Math.min(100,(current/required)*100);







    totalWeight+=importance;



    weightedScore+=match*importance;







    if (current<required) gaps++;







    return {



      skill:r.skill,



      required_level:required,



      student_level:current,



      evidence_count:Number(r.evidence_count),



      match_percent:Number(match.toFixed(2)),



      gap:current<required



    };



  });







  const readiness=totalWeight



    ? weightedScore/totalWeight



    : 0;







  db.prepare(`



    INSERT INTO student_readiness



    (student_id,employer_id,readiness_score,skill_gaps)



    VALUES (?,?,?,?)



  `).run(



    studentId,



    employerId,



    readiness,



    gaps



  );







  res.json({



    ok:true,



    version:'5.0.0',



    student_id:studentId,



    employer_id:employerId,



    readiness_score:Number(readiness.toFixed(2)),



    skill_gaps:gaps,



    requirements:skills



  });



});







