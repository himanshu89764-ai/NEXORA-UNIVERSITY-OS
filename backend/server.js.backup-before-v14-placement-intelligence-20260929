function v8HashPassword(password, salt) {



  return crypto.scryptSync(password, salt, 64).toString('hex');



}







function v8CreatePassword(password) {



  const salt=crypto.randomBytes(16).toString('hex');



  const hash=v8HashPassword(password,salt);



  return {salt,hash};



}







function v8VerifyPassword(password,salt,expected) {



  const actual=Buffer.from(v8HashPassword(password,salt),'hex');



  const target=Buffer.from(expected,'hex');



  return actual.length===target.length &&



    crypto.timingSafeEqual(actual,target);



}







function v8CreateToken() {



  return crypto.randomBytes(32).toString('hex');



}







function v8TokenHash(token) {



  return crypto.createHash('sha256').update(token).digest('hex');



}







function v8GetAuthUser(req) {



  const header=req.headers.authorization || '';



  if(!header.startsWith('Bearer ')) return null;







  const token=header.slice(7).trim();



  if(!token) return null;







  return db.prepare(`



    SELECT



      u.id,



      u.institution_id,



      u.name,



      u.email,



      u.role,



      u.status,



      s.id AS session_id,



      s.expires_at



    FROM auth_sessions s



    JOIN user_accounts u ON u.id=s.user_id



    WHERE s.token_hash=?



      AND s.expires_at>datetime('now')



      AND u.status='active'



  `).get(v8TokenHash(token));



}







function v8RequireAuth(req,res,next) {



  const user=v8GetAuthUser(req);







  if(!user) {



    return res.status(401).json({



      success:false,



      error:'Authentication required'



    });



  }







  req.authUser=user;



  next();



}







function v8RequirePermission(permission) {



  return (req,res,next)=>{



    const user=req.authUser;



    const permissions=V8_PERMISSIONS[user.role] || [];







    if(!permissions.includes(permission)) {



      return res.status(403).json({



        success:false,



        error:'Permission denied',



        required:permission,



        role:user.role



      });



    }







    next();



  };



}







