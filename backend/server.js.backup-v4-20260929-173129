app.post('/api/v4/student-skill', (req,res) => {
  const {
    student_id,
    skill_id,
    level=0,
    evidence_count=0
  } = req.body || {};

  if (!student_id || !skill_id)
    return res.status(400).json({
      ok:false,
      error:'student_id and skill_id required'
    });

  if (!v3Exists('students', student_id))
    return res.status(404).json({
      ok:false,
      error:'Student not found'
    });

  if (!v3Exists('skills', skill_id))
    return res.status(404).json({
      ok:false,
      error:'Skill not found'
    });

  db.prepare(`
    INSERT INTO student_skills
    (student_id,skill_id,level,evidence_count,last_assessed_at)
    VALUES (?,?,?,?,CURRENT_TIMESTAMP)
    ON CONFLICT(student_id,skill_id)
    DO UPDATE SET
      level=excluded.level,
      evidence_count=excluded.evidence_count,
      last_assessed_at=CURRENT_TIMESTAMP
  `).run(student_id,skill_id,level,evidence_count);

  res.json({
    ok:true,
    message:'Student skill updated'
  });
});

