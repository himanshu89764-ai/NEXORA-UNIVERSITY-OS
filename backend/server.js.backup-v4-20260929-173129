app.get('/api/v4/skill-passport/:studentId', (req,res) => {
  const studentId=Number(req.params.studentId);

  const student=db.prepare(`
    SELECT s.*,c.name AS college_name
    FROM students s
    LEFT JOIN colleges c ON c.id=s.college_id
    WHERE s.id=?
  `).get(studentId);

  if (!student)
    return res.status(404).json({
      ok:false,
      error:'Student not found'
    });

  const skills=db.prepare(`
    SELECT
      sk.id AS skill_id,
      sk.name AS skill,
      sk.category,
      ss.level,
      ss.evidence_count,
      ss.last_assessed_at,
      COALESCE(
        SUM(CASE WHEN se.verified=1 THEN 1 ELSE 0 END),0
      ) AS verified_evidence
    FROM student_skills ss
    JOIN skills sk ON sk.id=ss.skill_id
    LEFT JOIN skill_evidence se
      ON se.student_skill_id=ss.id
    WHERE ss.student_id=?
    GROUP BY ss.id
    ORDER BY ss.level DESC,sk.name
  `).all(studentId);

  const goals=db.prepare(`
    SELECT * FROM student_goals
    WHERE student_id=?
    ORDER BY id DESC
  `).all(studentId);

  res.json({
    ok:true,
    version:'4.0.0',
    passport:{
      student,
      skills,
      goals
    }
  });
});

app.get('/api/v4/skill-summary', (req,res) => {
  const summary=db.prepare(`
    SELECT
      sk.category,
      COUNT(DISTINCT ss.student_id) AS students,
      ROUND(AVG(ss.level),2) AS average_level,
      SUM(ss.evidence_count) AS evidence
    FROM student_skills ss
    JOIN skills sk ON sk.id=ss.skill_id
    GROUP BY sk.category
    ORDER BY students DESC
  `).all();

  res.json({
    ok:true,
    summary
  });
});


