app.get('/api/v3/academic-tree', (req,res) => {
  const rows=db.prepare(`
    SELECT
      u.id AS university_id,
      u.name AS university_name,
      c.id AS college_id,
      c.name AS college_name,
      d.id AS department_id,
      d.name AS department_name,
      p.id AS program_id,
      p.name AS program_name,
      p.degree,
      s.id AS semester_id,
      s.semester_number,
      sub.id AS subject_id,
      sub.name AS subject_name,
      sub.code AS subject_code,
      sub.credits
    FROM universities u
    LEFT JOIN colleges c ON c.university_id=u.id
    LEFT JOIN departments d ON d.college_id=c.id
    LEFT JOIN programs p ON p.department_id=d.id
    LEFT JOIN semesters s ON s.program_id=p.id
    LEFT JOIN subjects sub ON sub.semester_id=s.id
    ORDER BY u.id,c.id,d.id,p.id,s.semester_number,sub.id
  `).all();

  res.json({
    ok:true,
    version:'3.0.0',
    hierarchy:'University > College > Department > Program > Semester > Subject',
    data:rows
  });
});


