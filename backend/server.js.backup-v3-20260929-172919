// NEXORA UNIVERSITY OS — ACADEMIC STRUCTURE V3
// UNIVERSITY -> COLLEGE -> DEPARTMENT -> PROGRAM -> SEMESTER -> SUBJECT
// ============================================================

function v3Exists(table, id) {
  return db.prepare(`SELECT id FROM ${table} WHERE id = ?`).get(id);
}

app.post('/api/v3/department', (req,res) => {
  const { college_id, name, code='' } = req.body || {};
  if (!college_id || !name)
    return res.status(400).json({ok:false,error:'college_id and department name required'});

  if (!v3Exists('colleges', college_id))
    return res.status(404).json({ok:false,error:'College not found'});

  const result=db.prepare(
    `INSERT INTO departments (college_id,name,code) VALUES (?,?,?)`
  ).run(college_id,name,code);

  res.json({ok:true,id:result.lastInsertRowid,message:'Department created'});
});

app.post('/api/v3/program', (req,res) => {
  const { department_id, name, degree='', duration_years=null } = req.body || {};
  if (!department_id || !name)
    return res.status(400).json({ok:false,error:'department_id and program name required'});

  if (!v3Exists('departments', department_id))
    return res.status(404).json({ok:false,error:'Department not found'});

  const result=db.prepare(
    `INSERT INTO programs
     (department_id,name,degree,duration_years)
     VALUES (?,?,?,?)`
  ).run(department_id,name,degree,duration_years);

  res.json({ok:true,id:result.lastInsertRowid,message:'Program created'});
});

app.post('/api/v3/semester', (req,res) => {
  const { program_id, semester_number } = req.body || {};
  if (!program_id || !semester_number)
