const db = new Database('database/university-os.db');

db.exec(`
CREATE TABLE IF NOT EXISTS universities (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  code TEXT,
  city TEXT,
  state TEXT,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS colleges (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  university_id INTEGER NOT NULL,
  name TEXT NOT NULL,
  code TEXT,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS departments (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  college_id INTEGER NOT NULL,
  name TEXT NOT NULL,
  code TEXT,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS programs (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  department_id INTEGER NOT NULL,
  name TEXT NOT NULL,
  degree TEXT,
  duration_years INTEGER,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS semesters (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  program_id INTEGER NOT NULL,
  semester_number INTEGER NOT NULL,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS subjects (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  semester_id INTEGER NOT NULL,
  name TEXT NOT NULL,
  code TEXT,
  credits REAL,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS students (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  college_id INTEGER NOT NULL,
  name TEXT NOT NULL,
  enrollment_no TEXT,
  email TEXT,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS skills (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL UNIQUE,
  category TEXT,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS employers (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  industry TEXT,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);
`);

app.get('/api/v2/dashboard', (req, res) => {
  const count = table => db.prepare(`SELECT COUNT(*) AS total FROM ${table}`).get().total;

  res.json({
    ok: true,
    version: '2.0.0',
    institution: {
      universities: count('universities'),
      colleges: count('colleges'),
      departments: count('departments'),
      programs: count('programs'),
      semesters: count('semesters'),
      subjects: count('subjects'),
      students: count('students'),
      skills: count('skills'),
      employers: count('employers')
    }
  });
});

app.post('/api/v2/university', (req, res) => {
  const { name, code='', city='', state='' } = req.body || {};
  if (!name) return res.status(400).json({ok:false,error:'University name required'});

  const result = db.prepare(
    `INSERT INTO universities (name,code,city,state) VALUES (?,?,?,?)`
  ).run(name,code,city,state);

  res.json({
    ok:true,
    id: result.lastInsertRowid,
    message:'University created'
  });
});

app.post('/api/v2/college', (req, res) => {
  const { university_id, name, code='' } = req.body || {};
  if (!university_id || !name)
    return res.status(400).json({ok:false,error:'university_id and name required'});

  const result = db.prepare(
    `INSERT INTO colleges (university_id,name,code) VALUES (?,?,?)`
  ).run(university_id,name,code);

  res.json({ok:true,id:result.lastInsertRowid,message:'College created'});
});

app.get('/api/v2/universities', (req,res) => {
  res.json({ok:true,data:db.prepare(
    `SELECT * FROM universities ORDER BY id DESC`
  ).all()});
});


