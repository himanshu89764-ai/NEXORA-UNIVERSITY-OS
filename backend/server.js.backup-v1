const express = require('express');
const cors = require('cors');
const app = express();

app.use(cors());
app.use(express.json());

app.get('/api/health', (req, res) => {
  res.json({ ok: true, product: 'NEXORA UNIVERSITY OS', version: '0.1.0' });
});


// ============================================================
// NEXORA UNIVERSITY OS — INSTITUTION FOUNDATION V1
// ISOLATED FROM MAIN NEXORA
// ============================================================

const universityData = {
  universities: [],
  colleges: [],
  departments: [],
  programs: [],
  semesters: [],
  subjects: [],
  students: [],
  faculty: [],
  skills: [],
  employers: []
};

app.get('/api/university-os', (req, res) => {
  res.json({
    ok: true,
    product: 'NEXORA UNIVERSITY OS',
    version: '1.0.0',
    modules: [
      'University Management',
      'College Management',
      'Department Management',
      'Program & Semester Structure',
      'Subject & Curriculum Mapping',
      'Student Skill Passport',
      'Assessment Intelligence',
      'Placement Intelligence',
      'Employer Skill Matching',
      'Institutional Analytics'
    ],
    data: universityData
  });
});

app.post('/api/university', (req, res) => {
  const { name, code, city, state } = req.body || {};
  if (!name) return res.status(400).json({ ok:false, error:'University name required' });

  const item = {
    id: 'UNI-' + Date.now(),
    name, code: code || '',
    city: city || '', state: state || ''
  };
  universityData.universities.push(item);
  res.json({ ok:true, university:item });
});

app.post('/api/college', (req, res) => {
  const { universityId, name, code } = req.body || {};
  if (!universityId || !name)
    return res.status(400).json({ ok:false, error:'universityId and college name required' });

  const item = {
    id: 'COL-' + Date.now(),
    universityId, name, code: code || ''
  };
  universityData.colleges.push(item);
  res.json({ ok:true, college:item });
});

app.post('/api/department', (req, res) => {
  const { collegeId, name, code } = req.body || {};
  if (!collegeId || !name)
    return res.status(400).json({ ok:false, error:'collegeId and department name required' });

  const item = {
    id: 'DEP-' + Date.now(),
    collegeId, name, code: code || ''
  };
  universityData.departments.push(item);
  res.json({ ok:true, department:item });
});

app.get('/api/university-dashboard', (req, res) => {
  res.json({
    ok:true,
    dashboard:{
      universities: universityData.universities.length,
      colleges: universityData.colleges.length,
      departments: universityData.departments.length,
      programs: universityData.programs.length,
      subjects: universityData.subjects.length,
      students: universityData.students.length,
      faculty: universityData.faculty.length,
      skills: universityData.skills.length,
      employers: universityData.employers.length
    }
  });
});

app.get('/', (req, res) => {
  res.send('NEXORA UNIVERSITY OS: 200');
});

const PORT = process.env.PORT || 5100;
app.listen(PORT, () => {
  console.log('========================================');
  console.log('NEXORA UNIVERSITY OS: ONLINE');
  console.log('PORT:', PORT);
  console.log('MAIN NEXORA: UNTOUCHED');
  console.log('========================================');
});
