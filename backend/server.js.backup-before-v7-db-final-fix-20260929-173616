app.post('/api/v5/assessment-result', (req,res) => {
  const { assessment_id, student_id, score } = req.body || {};

  if (!assessment_id || !student_id || score === undefined)
    return res.status(400).json({
      ok:false,
      error:'assessment_id, student_id and score required'
    });

  const assessment=db.prepare(`
    SELECT * FROM assessments WHERE id=?
  `).get(assessment_id);

  if (!assessment)
    return res.status(404).json({
      ok:false,
      error:'Assessment not found'
    });

  if (!v3Exists('students',student_id))
    return res.status(404).json({
      ok:false,
      error:'Student not found'
    });

  const percentage=Math.max(
    0,
    Math.min(100,(Number(score)/Number(assessment.max_score))*100)
  );

  const passed=percentage>=40 ? 1 : 0;

  const result=db.prepare(`
    INSERT INTO assessment_results
    (assessment_id,student_id,score,percentage,passed)
    VALUES (?,?,?,?,?)
  `).run(
    assessment_id,
    student_id,
    score,
    percentage,
    passed
  );

  // Automatically create skill evidence for mapped skills.
  const mapped=db.prepare(`
    SELECT skill_id,weight
    FROM assessment_skills
    WHERE assessment_id=?
  `).all(assessment_id);

  for (const m of mapped) {
    const existing=db.prepare(`
      SELECT id FROM student_skills
      WHERE student_id=? AND skill_id=?
    `).get(student_id,m.skill_id);

    if (!existing) {
      db.prepare(`
        INSERT INTO student_skills
        (student_id,skill_id,level,evidence_count,last_assessed_at)
        VALUES (?,?,?,?,CURRENT_TIMESTAMP)
      `).run(
        student_id,
        m.skill_id,
        Math.min(5,Math.max(0,Math.round(percentage/20))),
        1
      );
    } else {
      db.prepare(`
        UPDATE student_skills
        SET level=?,
            evidence_count=evidence_count+1,
            last_assessed_at=CURRENT_TIMESTAMP
        WHERE id=?
      `).run(
        Math.min(5,Math.max(0,Math.round(percentage/20))),
        existing.id
      );
    }

    const ss=db.prepare(`
      SELECT id FROM student_skills
      WHERE student_id=? AND skill_id=?
    `).get(student_id,m.skill_id);

    db.prepare(`
      INSERT INTO skill_evidence
      (student_skill_id,source_type,source_id,score,verified,evidence_note)
      VALUES (?,?,?,?,?,?)
    `).run(
      ss.id,
      'assessment',
      String(assessment_id),
      percentage,
      1,
      'Automatically generated from verified assessment result'
    );
  }

  res.json({
    ok:true,
    result_id:result.lastInsertRowid,
    percentage:Number(percentage.toFixed(2)),
    passed:Boolean(passed),
    skills_updated:mapped.length
  });
});

