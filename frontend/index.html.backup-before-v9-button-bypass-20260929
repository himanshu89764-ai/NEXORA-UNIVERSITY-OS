<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NEXORA University OS</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Inter,Arial,sans-serif;background:#f5f7fb;color:#172033}
header{background:#111827;color:white;padding:22px 30px}
header h1{margin:0;font-size:25px}
header p{margin:7px 0 0;color:#cbd5e1}
nav{display:flex;gap:8px;flex-wrap:wrap;padding:14px 30px;background:white;border-bottom:1px solid #e5e7eb}
nav button{border:0;background:#eef2f7;padding:10px 15px;border-radius:9px;cursor:pointer}
nav button.active{background:#111827;color:white}
main{max-width:1250px;margin:auto;padding:28px}
.page{display:none}.page.active{display:block}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px}
.card,.panel{background:white;border:1px solid #e7eaf0;border-radius:15px;padding:20px;box-shadow:0 3px 16px #0000000a}
.panel{margin-top:20px}
.label{font-size:14px;color:#697386}.number{font-size:30px;font-weight:700;margin-top:8px}
input,select{padding:11px;border:1px solid #d5dbe5;border-radius:9px;width:100%;margin:6px 0}
button.primary{background:#111827;color:white;border:0;padding:11px 16px;border-radius:9px;cursor:pointer}
button.secondary{background:#eef2f7;border:0;padding:11px 16px;border-radius:9px;cursor:pointer}
.formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.status{padding:12px;border-radius:10px;background:#f0fdf4;margin-bottom:20px}
.error{background:#fef2f2;color:#991b1b}.success{background:#f0fdf4;color:#166534}
table{width:100%;border-collapse:collapse;margin-top:12px}
th,td{text-align:left;padding:10px;border-bottom:1px solid #edf0f3}
.badge{display:inline-block;background:#eef2ff;padding:5px 9px;border-radius:8px}
.hidden{display:none}
</style>
</head>

<body>
<header>
<h1>NEXORA University OS</h1>
<p>Academic Intelligence • Skills • Assessment • Placement</p>
</header>

<nav>
<button class="active" onclick="showPage('overview',this)">Overview</button>
<button onclick="showPage('onboarding',this)">Onboarding</button>
<button onclick="showPage('login',this)">Login</button>
<button onclick="showPage('academic',this)">Academic</button>
<button onclick="showPage('students',this)">Students</button>
<button onclick="showPage('faculty',this)">Faculty</button>
<button onclick="showPage('placement',this)">Placement</button>
<button onclick="showPage('skills',this)">Skills</button>
</nav>

<main>

<section id="overview" class="page active">
<h2>Institutional Overview</h2>
<div class="status" id="systemStatus">Checking University OS...</div>

<div class="panel">
<h3>Current Workspace</h3>
<div id="currentUser">Not logged in</div>
<button class="secondary" onclick="showPage('login')">Open Login</button>
</div>

<div class="grid" id="dashboardCards" style="margin-top:20px"></div>

<div class="panel">
<h3>University Intelligence Layer</h3>
<p>
University → College → Department → Program → Semester → Subject
is connected with Skills → Assessments → Placement Intelligence.
</p>
</div>
</section>

<section id="onboarding" class="page">
<h2>Institution Onboarding</h2>

<div class="panel">
<h3>Step 1 — Create Institution</h3>
<div class="formgrid">
<div><label>Institution Name</label><input id="instName" placeholder="Example University"></div>
<div><label>Institution Code</label><input id="instCode" placeholder="EXU"></div>
<div><label>Type</label>
<select id="instType">
<option value="university">University</option>
<option value="college">College</option>
<option value="institute">Institute</option>
</select>
</div>
<div><label>City</label><input id="instCity" placeholder="City"></div>
<div><label>State</label><input id="instState" placeholder="State"></div>
</div>
<br>
<button class="primary" onclick="createInstitution()">Create Institution</button>
<div id="instResult"></div>
</div>

<div class="panel">
<h3>Step 2 — Create Institutional User</h3>
<div class="formgrid">
<div><label>Institution ID</label><input id="userInstId" type="number" placeholder="Created institution ID"></div>
<div><label>Name</label><input id="userName" placeholder="Administrator name"></div>
<div><label>Email</label><input id="userEmail" type="email" placeholder="admin@example.edu"></div>
<div><label>Role</label>
<select id="userRole">
<option>UNIVERSITY_ADMIN</option>
<option>DEAN</option>
<option>HOD</option>
<option>FACULTY</option>
<option>TPO</option>
<option>STUDENT</option>
</select>
</div>
</div>
<br>
<button class="primary" onclick="createUser()">Create User</button>
<div id="userResult"></div>
</div>

<div class="panel">
<h3>Step 3 — Set Password</h3>
<div class="formgrid">
<div><label>User ID</label><input id="passwordUserId" type="number" placeholder="Created user ID"></div>
<div><label>Password</label><input id="password" type="password" placeholder="Minimum 8 characters"></div>
</div>
<br>
<button class="primary" onclick="setPassword()">Set Secure Password</button>
<div id="passwordResult"></div>
</div>
</section>

<section id="login" class="page">
<h2>Institution Login</h2>
<div class="panel" style="max-width:600px">
<label>Institution ID</label>
<input id="loginInstitutionId" type="number" placeholder="Institution ID">

<label>Email</label>
<input id="loginEmail" type="email" placeholder="Email">

<label>Password</label>
<input id="loginPassword" type="password" placeholder="Password">

<br>
<button class="primary" onclick="login()">Login</button>
<button class="secondary" onclick="logout()">Logout</button>
<div id="loginResult"></div>
</div>
</section>

<section id="academic" class="page">
<h2>Academic Structure</h2>
<div class="grid" id="academicCards"></div>
<div class="panel">
<h3>Academic Hierarchy</h3>
<div id="academicTree">Loading...</div>
</div>
</section>

<section id="students" class="page">
<h2>Student Intelligence</h2>
<div class="grid">
<div class="card"><div class="label">Students</div><div class="number" id="studentCount">0</div></div>
<div class="card"><div class="label">Skill Evidence</div><div class="number" id="evidenceCount">0</div></div>
<div class="card"><div class="label">Career Goals</div><div class="number" id="goalCount">0</div></div>
</div>
<div class="panel">
<h3>Skill Passport</h3>
<p>Evidence-backed student skill profiles and career goals.</p>
</div>
</section>

<section id="faculty" class="page">
<h2>Faculty Workspace</h2>
<div class="grid">
<div class="card"><div class="label">Programs</div><div class="number" id="facultyPrograms">0</div></div>
<div class="card"><div class="label">Subjects</div><div class="number" id="facultySubjects">0</div></div>
<div class="card"><div class="label">Assessments</div><div class="number" id="assessmentCount">0</div></div>
</div>
</section>

<section id="placement" class="page">
<h2>Placement Intelligence</h2>
<div class="grid">
<div class="card"><div class="label">Employers</div><div class="number" id="employerCount">0</div></div>
<div class="card"><div class="label">Readiness Records</div><div class="number" id="readinessCount">0</div></div>
<div class="card"><div class="label">Average Readiness</div><div class="number" id="readinessAvg">0%</div></div>
<div class="card"><div class="label">Skill Gaps</div><div class="number" id="skillGaps">0</div></div>
</div>
</section>

<section id="skills" class="page">
<h2>Skill Intelligence</h2>
<div class="panel">
<h3>Institutional Skill Summary</h3>
<div id="skillTable">Loading...</div>
</div>
</section>

</main>

<script>
const $=id=>document.getElementById(id);
let authToken=localStorage.getItem('nexora_university_token')||'';

function showPage(id,button){
 document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
 document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));
 $(id).classList.add('active');
 if(button) button.classList.add('active');
}

async function getJSON(url,options={}){
 const headers=options.headers||{};
 if(authToken) headers.Authorization='Bearer '+authToken;
 options.headers=headers;
 const r=await fetch(url,options);
 const d=await r.json().catch(()=>({}));
 if(!r.ok) throw new Error(d.error||'Request failed');
 return d;
}

function result(id,message,ok=true){
 const el=$(id);
 el.className='status '+(ok?'success':'error');
 el.textContent=message;
}

async function createInstitution(){
  try{
    const nameEl=document.querySelector('#instName');
    const codeEl=document.querySelector('#instCode');
    const typeEl=document.querySelector('#instType');
    const cityEl=document.querySelector('#instCity');
    const stateEl=document.querySelector('#instState');

    let name=(nameEl?.value || '').trim();

    if(!name){
      name=window.prompt('Enter Institution Name:','NEXORA Demo University');
      if(name===null) return;
      name=String(name).trim();
    }

    if(!name){
      result('instResult','Please enter Institution Name',false);
      return;
    }

    const payload={
      name:name,
      code:String(codeEl?.value || '').trim() || null,
      type:String(typeEl?.value || 'university').trim() || 'university',
      city:String(cityEl?.value || '').trim(),
      state:String(stateEl?.value || '').trim(),
      country:'India'
    };

    console.log('NEXORA V9 FINAL INSTITUTION PAYLOAD:',payload);

    const response=await fetch('/api/v7/institution?nocache='+Date.now(),{
      method:'POST',
      cache:'no-store',
      headers:{
        'Content-Type':'application/json',
        'Accept':'application/json',
        'Cache-Control':'no-cache'
      },
      body:JSON.stringify(payload)
    });

    const data=await response.json().catch(()=>({}));

    if(!response.ok){
      throw new Error(data.error || ('Institution creation failed: HTTP '+response.status));
    }

    if(!data.institution || !data.institution.id){
      throw new Error('Institution created but server returned no institution ID');
    }

    const id=data.institution.id;

    const userInst=document.querySelector('#userInstId');
    const loginInst=document.querySelector('#loginInstitutionId');

    if(userInst) userInst.value=id;
    if(loginInst) loginInst.value=id;

    result(
      'instResult',
      'Institution created successfully. ID: '+id,
      true
    );

    console.log('NEXORA V9 INSTITUTION CREATED:',data.institution);

  }catch(e){
    console.error('NEXORA V9 FINAL CREATE INSTITUTION ERROR:',e);
    result('instResult',e.message || 'Institution creation failed',false);
  }
}
async function createUser(){
 try{
  const d=await getJSON('/api/v7/user',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({
    institutionId:Number($('userInstId').value),
    name:$('userName').value,
    email:$('userEmail').value,
    role:$('userRole').value
   })
  });

  $('passwordUserId').value=d.user.id;
  $('loginEmail').value=d.user.email;

  result(
   'userResult',
   'User created successfully. User ID: '+d.user.id
  );
 }catch(e){result('userResult',e.message,false)}
}

async function setPassword(){
 try{
  const d=await getJSON('/api/v8/set-password',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({
    userId:Number($('passwordUserId').value),
    password:$('password').value
   })
  });

  result('passwordResult',d.message||'Password configured securely');
 }catch(e){result('passwordResult',e.message,false)}
}

async function login(){
 try{
  const d=await getJSON('/api/v8/login',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({
    institutionId:Number($('loginInstitutionId').value),
    email:$('loginEmail').value,
    password:$('loginPassword').value
   })
  });

  authToken=d.token;
  localStorage.setItem('nexora_university_token',authToken);

  $('currentUser').innerHTML=
   '<strong>'+d.user.name+'</strong> · '+
   '<span class="badge">'+d.user.role+'</span>'+
   '<br>Institution ID: '+d.user.institutionId+
   '<br><small>'+d.user.email+'</small>';

  result('loginResult','Login successful — '+d.user.role);
 }catch(e){result('loginResult',e.message,false)}
}

async function logout(){
 try{
  if(authToken){
   await getJSON('/api/v8/logout',{method:'POST'});
  }
 }catch(e){}
 authToken='';
 localStorage.removeItem('nexora_university_token');
 $('currentUser').textContent='Not logged in';
 $('loginResult').className='status';
 $('loginResult').textContent='Logged out';
}

async function loadDashboard(){
 try{
  const d=await getJSON('/api/v2/dashboard');
  const x=d.institution||d;

  $('systemStatus').textContent='NEXORA University OS — Institutional Database ONLINE';

  const labels={
   universities:'Universities',colleges:'Colleges',
   departments:'Departments',programs:'Programs',
   semesters:'Semesters',subjects:'Subjects',
   students:'Students',skills:'Skills',employers:'Employers'
  };

  $('dashboardCards').innerHTML=Object.entries(labels).map(([k,v])=>
   '<div class="card"><div class="label">'+v+
   '</div><div class="number">'+(x[k]||0)+'</div></div>'
  ).join('');

  $('academicCards').innerHTML=
   ['universities','colleges','departments','programs','semesters','subjects']
   .map(k=>'<div class="card"><div class="label">'+labels[k]+
   '</div><div class="number">'+(x[k]||0)+'</div></div>').join('');

  $('studentCount').textContent=x.students||0;
  $('facultyPrograms').textContent=x.programs||0;
  $('facultySubjects').textContent=x.subjects||0;
  $('employerCount').textContent=x.employers||0;
 }catch(e){
  $('systemStatus').textContent='NEXORA University OS API offline';
 }
}

async function loadAcademic(){
 try{
  const d=await getJSON('/api/v3/academic-tree');
  const rows=d.data||[];

  if(!rows.length){
   $('academicTree').innerHTML='<p>No academic structure added yet.</p>';
   return;
  }

  $('academicTree').innerHTML=
   '<table><tr><th>University</th><th>College</th><th>Department</th><th>Program</th><th>Semester</th><th>Subject</th></tr>'+
   rows.map(r=>'<tr><td>'+(r.university_name||'—')+
   '</td><td>'+(r.college_name||'—')+
   '</td><td>'+(r.department_name||'—')+
   '</td><td>'+(r.program_name||'—')+
   '</td><td>'+(r.semester_number||'—')+
   '</td><td>'+(r.subject_name||'—')+'</td></tr>').join('')+
   '</table>';
 }catch(e){
  $('academicTree').textContent='Academic API unavailable';
 }
}

async function loadIntelligence(){
 try{
  const a=await getJSON('/api/v5/assessment-summary');
  const x=a.summary||{};
  $('assessmentCount').textContent=x.total_attempts||0;
 }catch(e){}

 try{
  const p=await getJSON('/api/v5/placement-summary');
  const x=p.summary||{};
  $('readinessCount').textContent=x.readiness_records||0;
  $('readinessAvg').textContent=(x.average_readiness||0)+'%';
  $('skillGaps').textContent=x.total_skill_gaps||0;
 }catch(e){}

 try{
  const s=await getJSON('/api/v4/skill-summary');
  const rows=s.summary||[];

  $('skillTable').innerHTML=rows.length
   ? '<table><tr><th>Category</th><th>Students</th><th>Average Level</th><th>Evidence</th></tr>'+
     rows.map(r=>'<tr><td><span class="badge">'+
     (r.category||'General')+'</span></td><td>'+
     (r.students||0)+'</td><td>'+
     (r.average_level||0)+'/5</td><td>'+
     (r.evidence||0)+'</td></tr>').join('')+
     '</table>'
   : '<p>No skill data yet.</p>';
 }catch(e){}
}

async function restoreSession(){
 if(!authToken) return;

 try{
  const d=await getJSON('/api/v8/me');
  $('currentUser').innerHTML=
   '<strong>'+d.user.name+'</strong> · '+
   '<span class="badge">'+d.user.role+'</span>'+
   '<br>Institution ID: '+d.user.institutionId+
   '<br><small>'+d.user.email+'</small>';
 }catch(e){
  authToken='';
  localStorage.removeItem('nexora_university_token');
 }
}

loadDashboard();
loadAcademic();
loadIntelligence();
restoreSession();
</script>
</body>
</html>
