<script>
(function(){
  if(window.__NEXORA_V10_ACADEMIC_UI__) return;
  window.__NEXORA_V10_ACADEMIC_UI__ = true;

  function institutionId(){
    return Number(
      document.getElementById('v10InstitutionId')?.value ||
      document.getElementById('loginInstitutionId')?.value ||
      localStorage.getItem('nexora_university_institution_id') ||
      1
    );
  }

  function msg(text, ok=true){
    const el=document.getElementById('v10AcademicMessage');
    if(el){
      el.textContent=text;
      el.style.background=ok ? '#eefbf1' : '#fff1f1';
      el.style.color=ok ? '#176b2c' : '#a11';
    }
  }

  async function post(url, body){
    const r=await fetch(url,{
      method:'POST',
      headers:{'Content-Type':'application/json','Cache-Control':'no-cache'},
      body:JSON.stringify(body)
    });
    const d=await r.json().catch(()=>({success:false,error:'Invalid server response'}));
    if(!r.ok || d.success===false) throw new Error(d.error || 'Request failed');
    return d;
  }

  function fill(id, items, labelFn){
    const el=document.getElementById(id);
    if(!el) return;
    el.innerHTML = items.length
      ? items.map(x=>`<option value="${x.id}">${labelFn(x)}</option>`).join('')
      : '<option value="">No data yet</option>';
  }

  function esc(v){
    return String(v ?? '').replace(/[&<>"']/g,m=>({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[m]));
  }

  window.v10LoadTree = async function(){
    try{
      const id=institutionId();
      const r=await fetch('/api/v10/academic/'+id+'?v='+Date.now(),{
        cache:'no-store'
      });
      const d=await r.json();
      if(!r.ok || d.success===false) throw new Error(d.error || 'Academic tree failed');

      const t=d.tree || {};
      const colleges=t.colleges||[];
      const departments=t.departments||[];
      const programs=t.programs||[];
      const semesters=t.semesters||[];
      const subjects=t.subjects||[];

      fill('v10CollegeSelect',colleges,x=>esc(x.name));
      fill('v10DepartmentSelect',departments,x=>esc(x.name));
      fill('v10ProgramSelect',programs,x=>esc(x.name+' ('+x.code+')'));
      fill('v10SemesterSelect',semesters,x=>'Semester '+x.semester_number);

      const root=document.getElementById('v10AcademicTree');

      if(!colleges.length){
        root.innerHTML='<div style="padding:16px;color:#777;">No academic structure yet. Create your first College.</div>';
        return;
      }

      root.innerHTML=colleges.map(c=>{
        const deps=departments.filter(d=>d.college_id===c.id);
        return `
          <div style="margin:10px 0;padding:14px;border-left:4px solid #555;background:#fafafa;border-radius:8px;">
            <strong>College: ${esc(c.name)}</strong>
            ${c.code ? ' · '+esc(c.code) : ''}
            ${deps.map(dep=>{
              const progs=programs.filter(p=>p.department_id===dep.id);
              return `
                <div style="margin:10px 0 0 18px;padding:10px;border-left:3px solid #aaa;">
                  <strong>Department: ${esc(dep.name)}</strong>
                  ${dep.code ? ' · '+esc(dep.code) : ''}
                  ${progs.map(prog=>{
                    const sems=semesters.filter(s=>s.program_id===prog.id);
                    return `
                      <div style="margin:8px 0 0 18px;">
                        <strong>Program: ${esc(prog.name)}</strong>
                        ${prog.code ? ' · '+esc(prog.code) : ''}
                        ${sems.map(sem=>{
                          const subs=subjects.filter(s=>s.semester_id===sem.id);
                          return `
                            <div style="margin:7px 0 0 18px;">
                              <strong>Semester ${esc(sem.semester_number)}</strong>
                              ${subs.length
                                ? '<ul style="margin:5px 0 0 20px;">'+subs.map(sub=>
                                    `<li>${esc(sub.name)}${sub.code?' · '+esc(sub.code):''}${sub.credits!=null?' · '+esc(sub.credits)+' credits':''}</li>`
                                  ).join('')+'</ul>'
                                : '<div style="color:#999;margin-left:18px;">No subjects</div>'
                              }
                            </div>`;
                        }).join('')}
                      </div>`;
                  }).join('')}
                </div>`;
            }).join('')}
          </div>`;
      }).join('');
    }catch(e){
      msg(e.message,false);
    }
  };

  window.v10CreateCollege = async function(){
    try{
      const name=document.getElementById('v10CollegeName').value.trim();
      if(!name) throw new Error('College name is required');
      await post('/api/v10/college',{
        institutionId:institutionId(),
        name,
        code:document.getElementById('v10CollegeCode').value.trim(),
        city:document.getElementById('v10CollegeCity').value.trim()
      });
      msg('College created successfully.');
      document.getElementById('v10CollegeName').value='';
      await v10LoadTree();
    }catch(e){msg(e.message,false);}
  };

  window.v10CreateDepartment = async function(){
    try{
      const collegeId=Number(document.getElementById('v10CollegeSelect').value);
      const name=document.getElementById('v10DepartmentName').value.trim();
      if(!collegeId) throw new Error('Select College');
      if(!name) throw new Error('Department name is required');
      await post('/api/v10/department',{
        institutionId:institutionId(),collegeId,name,
        code:document.getElementById('v10DepartmentCode').value.trim()
      });
      msg('Department created successfully.');
      document.getElementById('v10DepartmentName').value='';
      await v10LoadTree();
    }catch(e){msg(e.message,false);}
  };

  window.v10CreateProgram = async function(){
    try{
      const departmentId=Number(document.getElementById('v10DepartmentSelect').value);
      const name=document.getElementById('v10ProgramName').value.trim();
      if(!departmentId) throw new Error('Select Department');
      if(!name) throw new Error('Program name is required');
      await post('/api/v10/program',{
        institutionId:institutionId(),departmentId,name,
        code:document.getElementById('v10ProgramCode').value.trim(),
        durationYears:Number(document.getElementById('v10ProgramDuration').value)||4
      });
      msg('Program created successfully.');
      document.getElementById('v10ProgramName').value='';
      await v10LoadTree();
    }catch(e){msg(e.message,false);}
  };

  window.v10CreateSemester = async function(){
    try{
      const programId=Number(document.getElementById('v10ProgramSelect').value);
      const semesterNumber=Number(document.getElementById('v10SemesterNumber').value);
      if(!programId) throw new Error('Select Program');
      if(!semesterNumber) throw new Error('Semester number is required');
      await post('/api/v10/semester',{
        institutionId:institutionId(),programId,semesterNumber
      });
      msg('Semester created successfully.');
      document.getElementById('v10SemesterNumber').value='';
      await v10LoadTree();
    }catch(e){msg(e.message,false);}
  };

  window.v10CreateSubject = async function(){
    try{
      const semesterId=Number(document.getElementById('v10SemesterSelect').value);
      const name=document.getElementById('v10SubjectName').value.trim();
      if(!semesterId) throw new Error('Select Semester');
      if(!name) throw new Error('Subject name is required');
      await post('/api/v10/subject',{
        institutionId:institutionId(),semesterId,name,
        code:document.getElementById('v10SubjectCode').value.trim(),
        credits:Number(document.getElementById('v10SubjectCredits').value)||0
      });
      msg('Subject created successfully.');
      document.getElementById('v10SubjectName').value='';
      await v10LoadTree();
    }catch(e){msg(e.message,false);}
  };

  document.addEventListener('DOMContentLoaded',()=>{
    setTimeout(v10LoadTree,300);
  });
})();
</script>
<!-- NEXORA V10 ACADEMIC UI -->


<!-- NEXORA V11 CURRICULUM UI -->
<section id="v11CurriculumUI" style="margin-top:24px;">
<div style="background:#fff;border:1px solid #ddd;border-radius:14px;padding:22px;">
<h2 style="margin:0 0 6px;">Curriculum Intelligence</h2>
<p style="color:#666;margin:0 0 20px;">Subject → Unit → Topic → Learning Outcome</p>

<input id="v11InstitutionId" type="hidden" value="1">

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;">

<div style="border:1px solid #ddd;border-radius:12px;padding:16px;">
<h3>1. Unit</h3>
<select id="v11SubjectSelect" style="width:100%;padding:10px;margin:5px 0;"></select>
<input id="v11UnitNumber" type="number" min="1" placeholder="Unit Number" style="width:100%;padding:10px;margin:5px 0;">
<input id="v11UnitName" placeholder="Unit Name" style="width:100%;padding:10px;margin:5px 0;">
<textarea id="v11UnitDescription" placeholder="Unit Description" style="width:100%;padding:10px;margin:5px 0;"></textarea>
<button onclick="v11CreateUnit()" class="primary">Create Unit</button>
</div>

<div style="border:1px solid #ddd;border-radius:12px;padding:16px;">
<h3>2. Topic</h3>
<select id="v11UnitSelect" style="width:100%;padding:10px;margin:5px 0;"></select>
<input id="v11TopicNumber" type="number" min="1" placeholder="Topic Number" style="width:100%;padding:10px;margin:5px 0;">
<input id="v11TopicName" placeholder="Topic Name" style="width:100%;padding:10px;margin:5px 0;">
<textarea id="v11TopicDescription" placeholder="Topic Description" style="width:100%;padding:10px;margin:5px 0;"></textarea>
<button onclick="v11CreateTopic()" class="primary">Create Topic</button>
</div>

<div style="border:1px solid #ddd;border-radius:12px;padding:16px;">
<h3>3. Learning Outcome</h3>
<select id="v11TopicSelect" style="width:100%;padding:10px;margin:5px 0;"></select>
<textarea id="v11Outcome" placeholder="Example: Explain the fundamental concepts..." style="width:100%;padding:10px;margin:5px 0;"></textarea>
<button onclick="v11CreateOutcome()" class="primary">Add Learning Outcome</button>
</div>

</div>

<div id="v11Message" style="margin-top:18px;padding:10px;border-radius:8px;"></div>

<div style="margin-top:22px;border-top:1px solid #eee;padding-top:18px;">
<div style="display:flex;justify-content:space-between;align-items:center;">
<h3 style="margin:0;">Curriculum Tree</h3>
<button onclick="v11LoadAll()">Refresh</button>
</div>
<div id="v11Tree" style="margin-top:14px;"></div>
</div>
</div>
</section>

<script>
(function(){
if(window.__NEXORA_V11_CURRICULUM_UI__) return;
window.__NEXORA_V11_CURRICULUM_UI__=true;

let v11Data={subjects:[],units:[],topics:[],learningOutcomes:[]};

function iid(){
return Number(
document.getElementById('v11InstitutionId')?.value ||
document.getElementById('loginInstitutionId')?.value || 1
);
}

function message(t,ok=true){
const e=document.getElementById('v11Message');
if(e){
e.textContent=t;
e.style.background=ok?'#eefbf1':'#fff1f1';
e.style.color=ok?'#176b2c':'#a11';
}
}

function esc(v){
return String(v??'').replace(/[&<>"']/g,m=>({
'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
}[m]));
}

async function post(url,body){
const r=await fetch(url,{
method:'POST',
headers:{'Content-Type':'application/json'},
body:JSON.stringify(body)
});
const d=await r.json().catch(()=>({success:false,error:'Invalid response'}));
if(!r.ok||d.success===false) throw new Error(d.error||'Request failed');
return d;
}

function fill(id,items,label){
const e=document.getElementById(id);
if(!e)return;
e.innerHTML=items.length
?items.map(x=>`<option value="${x.id}">${label(x)}</option>`).join('')
:'<option value="">No data available</option>';
}

window.v11LoadAll=async function(){
try{
const [cr,ac]=await Promise.all([
fetch('/api/v11/curriculum/'+iid()+'?v='+Date.now(),{cache:'no-store'}),
fetch('/api/v10/academic/'+iid()+'?v='+Date.now(),{cache:'no-store'})
]);

const c=await cr.json();
const a=await ac.json();

if(!c.success)throw new Error(c.error||'Curriculum load failed');

v11Data=c.curriculum||{subjects:[],units:[],topics:[],learningOutcomes:[]};
const subjects=(a.tree&&a.tree.subjects)||v11Data.subjects||[];

fill('v11SubjectSelect',subjects,x=>esc(x.name)+(x.code?' · '+esc(x.code):''));
fill('v11UnitSelect',v11Data.units,x=>{
const s=v11Data.subjects.find(z=>z.id===x.subject_id);
return 'Unit '+x.unit_number+': '+esc(x.name)+(s?' — '+esc(s.name):'');
});
fill('v11TopicSelect',v11Data.topics,x=>{
const u=v11Data.units.find(z=>z.id===x.unit_id);
return 'Topic '+x.topic_number+': '+esc(x.name)+(u?' — '+esc(u.name):'');
});

const root=document.getElementById('v11Tree');

if(!v11Data.subjects.length){
root.innerHTML='<div style="padding:16px;color:#777;">No subjects yet. Create Subject in V10 Academic Setup first.</div>';
return;
}

root.innerHTML=v11Data.subjects.map(s=>{
const units=v11Data.units.filter(u=>u.subject_id===s.id);
return `<div style="margin:10px 0;padding:14px;border-left:4px solid #555;background:#fafafa;border-radius:8px;">
<strong>Subject: ${esc(s.name)}</strong>${s.code?' · '+esc(s.code):''}
${units.length?units.map(u=>{
const topics=v11Data.topics.filter(t=>t.unit_id===u.id);
return `<div style="margin:10px 0 0 18px;padding:10px;border-left:3px solid #aaa;">
<strong>Unit ${esc(u.unit_number)}: ${esc(u.name)}</strong>
${topics.length?topics.map(t=>{
const los=v11Data.learningOutcomes.filter(o=>o.topic_id===t.id);
return `<div style="margin:8px 0 0 18px;">
<strong>Topic ${esc(t.topic_number)}: ${esc(t.name)}</strong>
${los.length?'<ul style="margin:5px 0 0 20px;">'+los.map(o=>'<li>'+esc(o.outcome)+'</li>').join('')+'</ul>':'<div style="color:#999;">No learning outcomes</div>'}
</div>`;
}).join(''):'<div style="color:#999;margin-left:18px;">No topics</div>'}
</div>`;
}).join(''):'<div style="color:#999;margin-left:18px;">No units</div>'}
</div>`;
}).join('');
}catch(e){message(e.message,false);}
};

window.v11CreateUnit=async function(){
try{
const subjectId=Number(document.getElementById('v11SubjectSelect').value);
const unitNumber=Number(document.getElementById('v11UnitNumber').value);
const name=document.getElementById('v11UnitName').value.trim();
if(!subjectId)throw new Error('Select Subject');
if(!unitNumber||!name)throw new Error('Unit number and name are required');
await post('/api/v11/unit',{
institutionId:iid(),subjectId,unitNumber,name,
description:document.getElementById('v11UnitDescription').value.trim()
});
message('Unit created successfully.');
document.getElementById('v11UnitName').value='';
document.getElementById('v11UnitDescription').value='';
await v11LoadAll();
}catch(e){message(e.message,false);}
};

window.v11CreateTopic=async function(){
try{
const unitId=Number(document.getElementById('v11UnitSelect').value);
const topicNumber=Number(document.getElementById('v11TopicNumber').value);
const name=document.getElementById('v11TopicName').value.trim();
if(!unitId)throw new Error('Select Unit');
if(!topicNumber||!name)throw new Error('Topic number and name are required');
await post('/api/v11/topic',{
institutionId:iid(),unitId,topicNumber,name,
description:document.getElementById('v11TopicDescription').value.trim()
});
message('Topic created successfully.');
document.getElementById('v11TopicName').value='';
document.getElementById('v11TopicDescription').value='';
await v11LoadAll();
}catch(e){message(e.message,false);}
};

window.v11CreateOutcome=async function(){
try{
const topicId=Number(document.getElementById('v11TopicSelect').value);
const outcome=document.getElementById('v11Outcome').value.trim();
if(!topicId)throw new Error('Select Topic');
if(!outcome)throw new Error('Learning outcome is required');
await post('/api/v11/learning-outcome',{
institutionId:iid(),topicId,outcome
});
message('Learning outcome added successfully.');
document.getElementById('v11Outcome').value='';
await v11LoadAll();
}catch(e){message(e.message,false);}
};

document.addEventListener('DOMContentLoaded',()=>setTimeout(v11LoadAll,500));
})();
</script>
<!-- NEXORA V11 CURRICULUM UI -->

